# LYC production environment — copy to .env and replace every value.
LYC_DOMAIN=lyc.example.com
LYC_DB_PASSWORD=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_16_CHARS
LYC_SESSION_TTL_SECONDS=43200
AWS_REGION=us-east-1
LYC_S3_BUCKET=REPLACE_WITH_PRIVATE_BUCKET_NAME
AWS_ACCESS_KEY_ID=REPLACE_WITH_IAM_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_IAM_SECRET
# Optional: only when using an S3-compatible provider instead of AWS S3.
# LYC_S3_ENDPOINT=https://s3.example.com
# JSON array; use unique guard IDs and temporary seed PINs. Do not commit this file.
LYC_GUARD_CREDENTIALS_JSON=[{"guardId":"1001","role":"Security","pin":"REPLACE"}]
